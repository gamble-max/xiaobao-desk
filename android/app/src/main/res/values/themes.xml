<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.XiaobaoDesk" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/xb_primary</item>
        <item name="colorOnPrimary">@color/xb_on_primary</item>
        <item name="colorSecondary">@color/xb_secondary</item>
        <item name="colorOnSecondary">@color/xb_on_secondary</item>
        <item name="android:colorBackground">@color/xb_bg_primary</item>
        <item name="colorSurface">@color/xb_bg_surface</item>
        <item name="colorOnSurface">@color/xb_text_primary</item>
        <item name="colorSurfaceVariant">@color/xb_bg_surface_elevated</item>
        <item name="colorOnSurfaceVariant">@color/xb_text_secondary</item>
        <item name="colorError">@color/xb_error</item>
        <item name="android:statusBarColor">@color/xb_bg_primary</item>
        <item name="android:navigationBarColor">@color/xb_bg_surface</item>
    </style>

    <style name="Theme.XiaobaoDesk.Fullscreen" parent="Theme.XiaobaoDesk">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
