<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xb_bg_primary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Default Display & Input Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/xb_bg_surface"
            app:cardCornerRadius="14dp"
            app:strokeColor="@color/xb_border_subtle"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="默认显示与操控偏好"
                    android:textColor="@color/xb_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swDefaultSuperScreen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="默认使用无线副屏模式（关闭则为原比例镜像）"
                    android:textColor="@color/xb_text_primary" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swDefaultVirtualMouse"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="默认使用 UU 虚拟鼠标（关闭则为直触手势）"
                    android:textColor="@color/xb_text_primary" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swPreserveCursor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="不抢占电脑原物理鼠标光标（推荐）"
                    android:textColor="@color/xb_text_primary" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swMigrateWindows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="无线副屏连接后自动将窗口与焦点移至副屏"
                    android:textColor="@color/xb_text_primary" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swAutoHideToolbar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="串流顶部数据与设置栏无操作 4 秒后自动收起"
                    android:textColor="@color/xb_text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="无线副屏触控缩放（放大桌面控件方便点按）"
                    android:textColor="@color/xb_text_secondary"
                    android:textSize="12sp" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/cgSecondaryScale"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipScale100"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1.0x 原始" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipScale115"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1.15x" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipScale120"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1.20x 推荐" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipScale125"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1.25x" />
                </com.google.android.material.chip.ChipGroup>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="默认帧率"
                    android:textColor="@color/xb_text_secondary"
                    android:textSize="12sp" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/cgSettingsFps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipSetFps60"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="60 FPS" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipSetFps120"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="120 FPS" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipSetFps144"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="144 FPS" />
                </com.google.android.material.chip.ChipGroup>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="默认编码格式"
                    android:textColor="@color/xb_text_secondary"
                    android:textSize="12sp" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/cgSettingsCodec"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipSetHevc"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="H.265 (HEVC)" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipSetH264"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="H.264 (AVC)" />
                </com.google.android.material.chip.ChipGroup>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="默认码率"
                        android:textColor="@color/xb_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvSettingsBitrate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12 Mbps"
                        android:textColor="@color/xb_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderSettingsBitrate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="2"
                    android:value="12"
                    android:valueFrom="2"
                    android:valueTo="50" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Audio & Host Screen Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/xb_bg_surface"
            app:cardCornerRadius="14dp"
            app:strokeColor="@color/xb_border_subtle"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="主屏声音与防窥默认"
                    android:textColor="@color/xb_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swMuteHostOnStream"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="串流后默认静音电脑主屏扬声器"
                    android:textColor="@color/xb_text_primary" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swPrivacyOnStream"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="串流后默认开启电脑主屏息屏防窥"
                    android:textColor="@color/xb_text_primary" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swAutoLockOnExit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="退出串流时自动锁定电脑屏幕"
                    android:textColor="@color/xb_text_primary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Peripherals, IME & Clipboard Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/xb_bg_surface"
            app:cardCornerRadius="14dp"
            app:strokeColor="@color/xb_border_subtle"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="外设、输入法与剪贴板"
                    android:textColor="@color/xb_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swAutoPeripherals"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="自动检测并接入蓝牙/外接键鼠与手柄"
                    android:textColor="@color/xb_text_primary" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swAutoIme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="无外接键盘时点击输入框自动呼出手机输入法"
                    android:textColor="@color/xb_text_primary" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swClipboardSync"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="开启电脑与手机双向剪贴板同步"
                    android:textColor="@color/xb_text_primary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvAppVersionInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="当前版本: XiaobaoDesk v1.4.0 (Build 5)"
            android:textColor="@color/xb_text_muted"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
